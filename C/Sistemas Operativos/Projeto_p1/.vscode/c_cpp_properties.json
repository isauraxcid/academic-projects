{
  "version": 4,
  "configurations": [
    {
      "name": "WSL-gcc",
      "includePath": [
        "${workspaceFolder}/inc",
        "${workspaceFolder}/src"
      ],
      "defines": [],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64",
      "browse": {
        "path": [
          "${workspaceFolder}/inc",
          "${workspaceFolder}/src"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}